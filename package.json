{
  "name": "mira",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "description": "嘴替（codename: Mira）—— 你负责想，它负责嘴。TRAE AI 创造力大赛参赛作品。",
  "author": "mountain",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:node": "tsc -p tsconfig.json",
    "build:renderer": "esbuild src/renderer/hud.ts --bundle --format=esm --target=chrome120 --loader:.wav=dataurl --outfile=dist/renderer/hud.js && node scripts/copy-assets.mjs",
    "build": "npm run build:node && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build:node && node --test \"dist/test/*.test.js\"",
    "test:e2e": "npm run build:node && E2E_SKIP=0 node --test \"dist/test/e2e/*.test.js\"",
    "fetch-models": "node scripts/fetch-wake-models.mjs",
    "smoke:main": "npm run build:node && node scripts/smoke-main.mjs",
    "smoke:electron": "npm run build && electron scripts/smoke-electron.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --enable-logging",
    "dev:log": "npm run build && electron . 2>&1 | tee -a logs/app-$(date +%Y%m%d-%H%M%S).log",
    "log:latest": "ls -t logs/app/*.log 2>/dev/null | head -1",
    "log:tail": "tail -f $(ls -t logs/app/*.log 2>/dev/null | head -1)",
    "push": "GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null git push \"$@\"",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish=never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish=never"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.2",
    "@earendil-works/pi-coding-agent": "0.80.2",
    "@picovoice/web-voice-processor": "^4.0.10",
    "dotenv": "^16.4.5",
    "onnxruntime-web": "^1.27.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "io.trae.zuiti",
    "productName": "嘴替",
    "artifactName": "zuiti-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "skills/**/*",
      "models/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
